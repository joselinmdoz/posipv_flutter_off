<odoo>
    <record id="view_posipv_catalog_product_tree" model="ir.ui.view">
        <field name="name">posipv.catalog.product.tree</field>
        <field name="model">posipv.catalog.product</field>
        <field name="arch" type="xml">
            <list string="Productos espejo">
                <field name="name"/>
                <field name="sku"/>
                <field name="sale_price"/>
                <field name="cost_price"/>
                <field name="currency_code"/>
                <field name="product_type"/>
                <field name="received_at"/>
            </list>
        </field>
    </record>
    <record id="view_posipv_catalog_product_form" model="ir.ui.view">
        <field name="name">posipv.catalog.product.form</field>
        <field name="model">posipv.catalog.product</field>
        <field name="arch" type="xml">
            <form string="Producto espejo POSIPV">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="external_uuid" readonly="1"/>
                            <field name="device_id"/>
                            <field name="product_id"/>
                        </group>
                        <group>
                            <field name="sku"/>
                            <field name="barcode"/>
                            <field name="currency_code"/>
                            <field name="received_at" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="sale_price"/>
                        <field name="cost_price"/>
                        <field name="category_name"/>
                        <field name="product_type"/>
                        <field name="unit_measure"/>
                        <field name="order_costing_mode"/>
                    </group>
                    <field name="payload_json"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_posipv_catalog_product" model="ir.actions.act_window">
        <field name="name">Productos espejo</field>
        <field name="res_model">posipv.catalog.product</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_posipv_catalog_product" name="Productos" parent="menu_posipv_catalogs" action="action_posipv_catalog_product" sequence="10" groups="posipv.group_posipv_viewer"/>

