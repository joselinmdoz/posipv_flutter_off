<odoo>
    <record id="view_posipv_sync_device_tree" model="ir.ui.view">
        <field name="name">posipv.sync.device.tree</field>
        <field name="model">posipv.sync.device</field>
        <field name="arch" type="xml">
            <list string="Dispositivos POSIPV">
                <field name="name"/>
                <field name="device_uuid"/>
                <field name="app_version"/>
                <field name="sync_enabled"/>
                <field name="last_seen_at"/>
                <field name="last_sync_at"/>
                <field name="push_count"/>
                <field name="pull_count"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <record id="view_posipv_sync_device_form" model="ir.ui.view">
        <field name="name">posipv.sync.device.form</field>
        <field name="model">posipv.sync.device</field>
        <field name="arch" type="xml">
            <form string="Dispositivo POSIPV">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="device_uuid" readonly="1"/>
                            <field name="app_version"/>
                            <field name="company_id"/>
                        </group>
                        <group>
                            <field name="active"/>
                            <field name="sync_enabled"/>
                            <field name="last_seen_at" readonly="1"/>
                            <field name="last_sync_at" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="api_key" password="True"/>
                        <field name="push_count" readonly="1"/>
                        <field name="pull_count" readonly="1"/>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_posipv_sync_device" model="ir.actions.act_window">
        <field name="name">Dispositivos</field>
        <field name="res_model">posipv.sync.device</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_posipv_sync_device"
        name="Dispositivos"
        parent="menu_posipv_monitoring"
        action="action_posipv_sync_device"
        sequence="10"
        groups="posipv.group_posipv_viewer"/>

    <record id="view_posipv_sync_log_tree" model="ir.ui.view">
        <field name="name">posipv.sync.log.tree</field>
        <field name="model">posipv.sync.log</field>
        <field name="arch" type="xml">
            <list string="Registros de sincronización">
                <field name="started_at"/>
                <field name="device_id"/>
                <field name="direction"/>
                <field name="endpoint"/>
                <field name="status"/>
                <field name="request_count"/>
                <field name="record_count"/>
                <field name="finished_at"/>
            </list>
        </field>
    </record>

    <record id="view_posipv_sync_log_form" model="ir.ui.view">
        <field name="name">posipv.sync.log.form</field>
        <field name="model">posipv.sync.log</field>
        <field name="arch" type="xml">
            <form string="Registro de sincronización">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="device_id"/>
                            <field name="direction"/>
                            <field name="endpoint"/>
                        </group>
                        <group>
                            <field name="status"/>
                            <field name="started_at"/>
                            <field name="finished_at"/>
                            <field name="record_count"/>
                        </group>
                    </group>
                    <group>
                        <field name="response_json"/>
                        <field name="error_message"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_posipv_sync_log" model="ir.actions.act_window">
        <field name="name">Registros de sincronización</field>
        <field name="res_model">posipv.sync.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_posipv_sync_log"
        name="Registros"
        parent="menu_posipv_monitoring"
        action="action_posipv_sync_log"
        sequence="20"
        groups="posipv.group_posipv_viewer"/>
</odoo>
